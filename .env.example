# Backend only - no usar NEXT_PUBLIC_
APPS_SCRIPT_URL=https://script.google.com/macros/s/REEMPLAZAR/exec
APPS_SCRIPT_API_KEY=reemplazar-con-la-misma-api-key-de-apps-script

# Recomendado: secreto independiente y largo para firmar la sesión admin.
# Si se omite, temporalmente se usa APPS_SCRIPT_API_KEY como fallback.
ADMIN_SESSION_SECRET=reemplazar-con-un-secreto-largo-y-aleatorio
